{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:check-size": "npm run build && node scripts/check-bundle-size.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/solid-query": "^5.102.8",
    "@tanstack/solid-virtual": "^3.13.37",
    "apache-arrow": "^21.2.0",
    "decimal.js-light": "^2.5.1",
    "lightweight-charts": "^5.2.1",
    "lucide-solid": "^1.41.0",
    "solid-js": "^1.9.15",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "^24.13.3",
    "eslint": "^9.39.5",
    "eslint-plugin-solid": "^0.14.5",
    "globals": "^17.12.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.6",
    "rollup-plugin-visualizer": "^6.0.11",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^3.2.7"
  }
